# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해 .env 를 만들고 값을 채우세요:   cp .env.example .env
# .env 는 .gitignore 에 들어 있어 GitHub에 올라가지 않습니다. (키를 절대 커밋하지 마세요)
# ─────────────────────────────────────────────────────────────

# Codyssey API 콘솔(usr.codyssey.kr → API 콘솔 → 내 API 키)에서 발급한 키
CODYSSEY_API_KEY=

# 키를 발급할 때 고른 "API 호환 방식"과 똑같이 적으세요: openai 또는 anthropic
#   openai    → https://copa.codyssey.kr/v1/chat/completions  (기본 모델 gpt-5-mini)
#   anthropic → https://copa.codyssey.kr/v1/messages          (기본 모델 claude-sonnet-4)
LLM_API_STYLE=openai

# (선택) 모델 이름 — 비우면 위 기본 모델 사용. 예: gpt-5-mini / claude-sonnet-4 / claude-haiku-4
LLM_MODEL=

# (선택) 아래는 보통 바꿀 필요 없음
CODYSSEY_BASE_URL=https://copa.codyssey.kr
CODYSSEY_SESSION_ID=traffic-ai-assistant
LLM_TIMEOUT=60

# (선택) 데이터 이름·단위 — 다른 데이터로 바꿀 때 수정
DATA_LABEL=I-94 고속도로 서쪽 방향 일교통량 (MnDOT ATR 301)
DATA_UNIT=대
